#!/usr/bin/env bash
#
# new-piece — deprecated.
#
# The repo moved to a file-passing workflow. To create a new piece:
#
#   1. Visit https://slides.elijahfrost.com/ and click "New from template",
#      or curl https://slides.elijahfrost.com/api/export/template/blank-deck > new.html
#   2. Hand new.html to an agent (Claude.ai). Tell it what the deck is about.
#   3. The agent returns a modified HTML file. Save it.
#   4. Upload via https://slides.elijahfrost.com/upload/.
#
# See _framework/v1/DECK-FORMAT.md and _framework/v1/SLIDE-TYPES.md for the
# format the agent reads.

cat <<'EOF' >&2
bin/new-piece is deprecated.

To create a new deck:
  1. Download the blank template:
       curl -s https://slides.elijahfrost.com/api/export/template/blank-deck > new.html
  2. Hand new.html to an agent and ask for the deck content.
  3. Upload the result at https://slides.elijahfrost.com/upload/.

See _framework/v1/DECK-FORMAT.md for the file contract.
EOF
exit 1
