{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": true,

  "rewrites": [
    {
      "source": "/catalog.json",
      "destination": "/api/catalog"
    },
    {
      "source": "/api/export/template/:name",
      "destination": "/api/export-template?name=:name"
    },
    {
      "source": "/api/export/:slug",
      "destination": "/api/export-piece?slug=:slug"
    },
    {
      "source": "/:slug/present/",
      "destination": "/_framework/v1/present.html"
    },
    {
      "source": "/:slug/present",
      "destination": "/_framework/v1/present.html"
    },
    {
      "source": "/:slug/",
      "destination": "/api/deck?slug=:slug"
    }
  ],

  "headers": [
    {
      "source": "/:slug/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com https://use.typekit.net; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; media-src 'self' https:; base-uri 'none'; form-action 'none'"
        }
      ]
    },
    {
      "source": "/_framework/v1/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
