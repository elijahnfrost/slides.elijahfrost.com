# Required env vars for slides.elijahfrost.com on Vercel.
# Copy to .env.local for `vercel dev` and set the same in the Vercel dashboard
# for production. Never commit real values to git.

# Shared bearer token the /upload page sends as X-Deck-Auth.
# Generate one: openssl rand -hex 32
DECK_UPLOAD_TOKEN=

# Fine-grained GitHub PAT with contents:write on the repo. The api/upload
# endpoint uses this to commit uploaded deck files.
GITHUB_PAT=

# Optional overrides (defaults shown).
# GITHUB_OWNER=elijahnfrost
# GITHUB_REPO=slides.elijahfrost.com
# GITHUB_BRANCH=main

# Optional comma-separated host allow-list for <iframe>/<video>/<audio> sources
# (in addition to the built-in: youtube.com, vimeo.com, slides.elijahfrost.com).
# ALLOWED_EMBED_HOSTS=
