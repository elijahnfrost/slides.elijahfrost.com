# Required env vars for slides.elijahfrost.com on Vercel.
# Copy to .env.local for `vercel dev` and set the same in the Vercel dashboard
# for production. Never commit real values to git.

# Vercel Blob read/write token. Created automatically when you add a Blob
# store to your Vercel project (Storage → Blob → Connect). The SDK reads
# this var automatically — do not rename it.
BLOB_READ_WRITE_TOKEN=

# Optional comma-separated host allow-list for <iframe>/<video>/<audio> sources
# (in addition to the built-in: youtube.com, vimeo.com, slides.elijahfrost.com).
# ALLOWED_EMBED_HOSTS=
